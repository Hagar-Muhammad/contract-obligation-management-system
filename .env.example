# Copy to .env at the repository root:  cp .env.example .env
# Read by docker compose (POSTGRES_*) and by the backend (everything else).
# Never commit .env.

# --- Local infrastructure (docker compose) ---
POSTGRES_USER=coms
POSTGRES_PASSWORD=coms
POSTGRES_DB=coms
# Host port for Postgres. 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_PORT=5433

# --- Backend ---
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://coms:coms@localhost:5433/coms
# Used by the test suite; defaults to the coms_test database created by infra/postgres/init.
TEST_DATABASE_URL=postgresql+psycopg://coms:coms@localhost:5433/coms_test
# JSON list of origins allowed to call the API from a browser.
CORS_ORIGINS=["http://localhost:5173"]
