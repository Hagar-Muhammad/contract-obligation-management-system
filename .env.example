# Copy to .env at the repository root:  cp .env.example .env
# Read by docker compose (POSTGRES_*) and by the backend (everything else).
# Never commit .env.

# --- Local infrastructure (docker compose) ---
POSTGRES_USER=coms
POSTGRES_PASSWORD=coms
POSTGRES_DB=coms
# Host port for Postgres. 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_PORT=5433

# --- Backend ---
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://coms:coms@localhost:5433/coms
# Used by the test suite; defaults to the coms_test database created by infra/postgres/init.
TEST_DATABASE_URL=postgresql+psycopg://coms:coms@localhost:5433/coms_test
# JSON list of origins allowed to call the API from a browser.
CORS_ORIGINS=["http://localhost:5173"]

# --- Authentication ---
# Required in production: a random value of at least 32 characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave unset locally to use the built-in development secret.
# JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
# Session length with "Keep me signed in" ticked (days) and unticked (hours).
REFRESH_TOKEN_TTL_DAYS=7
UNREMEMBERED_SESSION_HOURS=12

# Self sign-up from the login page (CR-01). New accounts get SELF_SIGNUP_ROLE only.
SELF_SIGNUP_ENABLED=true
SELF_SIGNUP_ROLE=employee

# Contracts: currency suggested for contract values, prefix of suggested contract numbers (CT-2026-0001),
# and how many days before its end date an active contract counts as "expiring soon".
DEFAULT_CURRENCY=EGP
CONTRACT_NUMBER_PREFIX=CT
EXPIRING_SOON_DAYS=60

# Contract documents (decision D-12). STORAGE_DIR holds the original files (include it in backups, NFR-BACK-02);
# a relative path is resolved from the directory the API is started in.
STORAGE_DIR=storage
UPLOAD_MAX_BYTES=20971520
UPLOAD_ALLOWED_TYPES=["pdf","docx","png","jpg"]
